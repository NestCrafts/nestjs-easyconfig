{
	"extends": "@rubiin/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"newLine": "lf",
		"module": "NodeNext",
  		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"declaration": true,
		"target": "ES2022",
		"declarationMap": true,
		"rootDir": "./src"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "tests/*.spec.ts"]
}
